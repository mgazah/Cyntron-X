# Cyntron-X pairing server
# Copy to .env for local use. On Render/Railway set these in the dashboard.

# Port to listen on (hosts usually set this for you)
PORT=8080

# Comma-separated list of sites allowed to call this API from a browser.
# Put your Vercel URL here, with no trailing slash. Use * only while testing.
ALLOWED_ORIGINS=http://localhost:4173

# How many link attempts can be in progress at once
MAX_ACTIVE_SESSIONS=20

# How many link attempts one IP address can start in 10 minutes
RATE_LIMIT_MAX=5
