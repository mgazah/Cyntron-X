# Cyntron-X environment template
# Copy to .env and fill in the values. Never commit .env itself.

# REQUIRED - WhatsApp session string from the pairing site.
# Format: Cyntron-X:~<base64 payload>
SESSION_ID=

# Bot behaviour
PREFIX=.
OWNER_NUMBER=

# Server port (Render/Railway/Heroku set this automatically)
PORT=3000

# Optional API keys used by some image/AI commands
IMGBB_API_KEY=
NVIDIA_API_KEY=
TELEGRAM_TOKEN=
GROQ_API_KEY=
OPENWEATHER_API_KEY=

# Chatbot / AI provider (used by .chatbot)
AI_API_URL=
AI_API_KEY=
AI_BOT_ID=cyntron-x

# Pairing service used by .pair
PAIR_API=https://cyntron-x-pair.onrender.com

# Optional - only needed for hosted auto-update flows
REPO_URL=https://github.com/mgazah/Cyntron-X
APP_URL=
